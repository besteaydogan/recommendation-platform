# Isolated local ports used by scripts/run-load-test.ps1
POSTGRES_IMAGE=postgres:17.9-alpine
KAFKA_IMAGE=apache/kafka:3.9.1
POSTGRES_PORT=5434
KAFKA_PORT=9093
APP_PORT=8081

DB_HOST=localhost
DB_PORT=5434
DB_NAME=recoflow_load_test
DB_USERNAME=recoflow
DB_PASSWORD=recoflow_load_test_password

KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_PRODUCT_VIEWS_TOPIC=product-views-load-test
KAFKA_PRODUCT_VIEWS_CONSUMER_GROUP=recoflow-product-views-load-test
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_BACKOFF=10ms

PRODUCT_VIEW_PRODUCER_ENABLED=true
PRODUCT_VIEWS_FILE_PATH=/app/data/product-views.json
PRODUCT_VIEW_INTERVAL_MS=1ms

BESTSELLER_REFRESH_ENABLED=false
BESTSELLER_REFRESH_INTERVAL_MS=30s
