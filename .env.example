# Images
POSTGRES_IMAGE=postgres:17.9-alpine
KAFKA_IMAGE=apache/kafka:3.9.1

# Host ports
POSTGRES_PORT=5433
KAFKA_PORT=9092
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=recoflow
DB_USERNAME=recoflow
DB_PASSWORD=recoflow_dev_password

# Kafka application settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCT_VIEWS_TOPIC=product-views
KAFKA_PRODUCT_VIEWS_CONSUMER_GROUP=recoflow-product-views

# Product-view producer
PRODUCT_VIEW_PRODUCER_ENABLED=false
PRODUCT_VIEWS_FILE_PATH=/app/data/product-views.json
PRODUCT_VIEW_INTERVAL_MS=1s

# Bestseller refresh
BESTSELLER_REFRESH_ENABLED=true
BESTSELLER_REFRESH_INTERVAL_MS=30s
